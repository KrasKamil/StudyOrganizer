# ── StudyOrganizer Discord Bot Bridge ──
# Token Twojego bota z https://discord.com/developers/applications (zakładka Bot -> Reset Token)
DISCORD_BOT_TOKEN=twoj_discord_bot_token_tutaj

# Projekt Firebase
FIREBASE_PROJECT_ID=organizer-637f1

# Klucz konta usługi Firebase (Service Account)
# Na komputerze: wystarczy wrzucić plik serviceAccountKey.json do tego folderu.
# Na Render.com / w chmurze: wklej całą zawartość pliku JSON jako jedną linię tutaj:
FIREBASE_SERVICE_ACCOUNT=

# Opcjonalnie: Twój UID użytkownika z Firebase Auth.
# Jeśli zostawisz puste, bot automatycznie wyśle ogłoszenia do wszystkich zarejestrowanych studentów w bazie.
TARGET_UID=

# Opcjonalnie: Filtrowanie kanałów (oddzielone przecinkami, bez #).
# Zostaw puste, aby bot nasłuchiwał na wszystkich kanałach tekstowych serwera.
ALLOWED_CHANNELS=ogloszenia,ogloszenia-starosty,materialy,terminy,projekty

# Port dla serwera WWW sprawdzającego stan bota (na Render.com)
PORT=3000
